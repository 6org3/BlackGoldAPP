# Copia este archivo a .env.local (gitignored) y completa los valores reales.
# Nunca commitear .env.local ni pegar estas claves en un chat.
#
# ATENCIÓN: este repositorio es PÚBLICO. Todo lo que entre aquí con un valor
# real queda publicado en internet, y entonces no basta con borrarlo: hay que
# rotar la credencial.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Solo para scripts operativos de scripts/ (nunca en el bundle del cliente).
SUPABASE_SERVICE_ROLE_KEY=

# Contraseñas de las cuentas QA sembradas, usadas por los scripts tmp_*.mjs.
# Antes estaban como literales dentro de los scripts; se sacaron al entorno
# porque el repo es público. Los valores reales los escribe
# tmp_sembrar_5clubes.mjs en backups-blackgold/credenciales_5clubes.json.
QA_SUPERADMIN_PASSWORD=
QA_OWNER_PASSWORD=
QA_CAS_OWNER_PASSWORD=
