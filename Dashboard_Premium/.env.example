# Copia este archivo a .env.local (gitignored) y completa los valores reales.
# Nunca commitear .env.local ni pegar estas claves en un chat.
#
# ATENCIÓN: este repositorio es PÚBLICO. Todo lo que entre aquí con un valor
# real queda publicado en internet, y entonces no basta con borrarlo: hay que
# rotar la credencial.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Captcha del formulario público de registro (Cloudflare Turnstile). OPCIONAL:
# si se deja vacío no se muestra el widget y el registro sigue funcionando —
# el límite por IP y por club de la Edge Function actúa siempre. Esta es la
# clave PÚBLICA (viaja en el bundle); el secreto NO va aquí, ver abajo.
# Claves de prueba oficiales de Cloudflare (públicas, documentadas, solo para
# desarrollo): 1x00000000000000000000AA siempre pasa, 2x00000000000000000000AB
# siempre falla.
VITE_TURNSTILE_SITE_KEY=

# Solo para scripts operativos de scripts/ (nunca en el bundle del cliente).
SUPABASE_SERVICE_ROLE_KEY=

# Contraseñas de las cuentas QA sembradas, usadas por los scripts tmp_*.mjs.
# Antes estaban como literales dentro de los scripts; se sacaron al entorno
# porque el repo es público. Los valores reales los escribe
# tmp_sembrar_5clubes.mjs en backups-blackgold/credenciales_5clubes.json.
QA_SUPERADMIN_PASSWORD=
QA_OWNER_PASSWORD=
QA_CAS_OWNER_PASSWORD=

# ---------------------------------------------------------------------------
# Entorno de las Edge Functions — NO se pone en este archivo.
# Vive en el proyecto de Supabase (Dashboard → Edge Functions → Secrets, o
# `npx supabase secrets set NOMBRE=valor`), porque lo lee Deno en el servidor.
# Se listan aquí solo para que no se descubran leyendo el código:
#
#   TURNSTILE_SECRET_KEY       Secreto del captcha del registro público. Si no
#                              existe, `registro-publico` omite la verificación
#                              (el widget del cliente tampoco se muestra sin
#                              VITE_TURNSTILE_SITE_KEY). Clave de prueba oficial
#                              de Cloudflare: 1x0000000000000000000000000000000AA
#   REGISTRO_LIMITE_IP_HORA    Máx. intentos de registro por IP y hora (def. 5).
#   REGISTRO_LIMITE_CLUB_DIA   Máx. altas efectivas por club y día (def. 20).
# ---------------------------------------------------------------------------
