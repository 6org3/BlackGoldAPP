# Copiar a .env y rellenar. NUNCA commitear .env con valores reales.

# URL del proyecto Supabase de BlackGoldAPP (misma base que usa blackgold-mcp
# y la app Dashboard_Premium).
SUPABASE_URL=

# Con RLS real desde v24, la anon key no puede leer ni escribir NINGUNA tabla.
# Este proceso corre local/servidor (nunca en un cliente web) y necesita la
# service_role key para que las 8 tools funcionen.
SUPABASE_SERVICE_ROLE_KEY=

# Opcional: si no hay service_role key, se usa esta como fallback — pero con
# RLS v24 todas las tools de este servidor fallarán con la anon key.
SUPABASE_ANON_KEY=

# Obligatoria para habilitar las tools CRM. Lista CSV de nombres de club
# exactos que este proceso MCP puede consultar o modificar. No usar "*".
CRM_ALLOWED_CLUBS=Black Gold

# Identidad operativa que quedará en la auditoría CRM. Ejemplos: lily,
# vegapunk. No sustituye el control de clubes anterior.
CRM_ACTOR_ID=
